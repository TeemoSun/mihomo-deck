# Mihomo Deck server settings
PORT=8080
DB_PATH=/data/mihomo-deck.db
STATIC_DIR=/app/static

# Mihomo external controller
MIHOMO_URL=http://192.168.5.2:9090
MIHOMO_SECRET=

# Initial administrator credentials; set a strong password before deployment.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Generate a random hexadecimal secret, for example: openssl rand -hex 32
JWT_SECRET=

TRUST_PROXY=false
COOKIE_SECURE=false
RETENTION_DAYS=30
SNAPSHOT_INTERVAL_MIN=30
LOG_PERSIST_LEVEL=info
TZ=Asia/Shanghai
